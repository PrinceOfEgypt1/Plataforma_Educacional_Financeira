{
  "schemaVersion": "1.0.0",
  "contractId": "PEF-UIUX-CONTRACT-FINANCIAMENTO-IMOBILIARIO",
  "contractStatus": "blocking-target",
  "createdAt": "2026-05-16",
  "module": {
    "id": "financiamento-imobiliario",
    "name": "Financiamento Imobiliário",
    "route": "/financiamento-imobiliario",
    "domain": "financing.real_estate",
    "frontendOnly": true,
    "description": "Contrato verificável de UI/UX para o módulo Imóvel da Plataforma Educacional Financeira."
  },
  "scope": {
    "includes": [
      "jornada frontend do módulo",
      "zonas e painéis de resultado",
      "CTAs e destinos esperados",
      "cards e propósito de componentes",
      "duplicação de informações entre zonas",
      "estados de interface",
      "responsividade mobile",
      "contrato mínimo de tabela financeira",
      "contrato mínimo de gráfico financeiro",
      "regras de acessibilidade",
      "regras de texto e integridade visual"
    ],
    "excludes": [
      "backend",
      "fórmulas financeiras",
      "contrato de API",
      "dependências",
      "lockfiles",
      "alteração visual direta",
      "implementação de correções"
    ]
  },
  "referencedStandards": [
